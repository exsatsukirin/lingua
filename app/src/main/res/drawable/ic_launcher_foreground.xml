<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher mark: 文 and A — the two scripts this app translates between, and the
  conventional "translation" glyph.

  Round-capped strokes keep the shapes legible after any adaptive-icon mask. Every
  stroke end (caps included) stays inside the 66dp safe circle, so a circular or
  squircle launcher mask never crops the mark. Both glyphs share a baseline at y≈70.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 文：点 -->
    <path
        android:pathData="M36,35 L38.5,41"
        android:strokeColor="#EAFBF7"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- 文：横 -->
    <path
        android:pathData="M26,47.5 L49,47.5"
        android:strokeColor="#EAFBF7"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- 文：撇 -->
    <path
        android:pathData="M35.5,47.5 L29,68"
        android:strokeColor="#EAFBF7"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- 文：捺 -->
    <path
        android:pathData="M38,47.5 L48,70"
        android:strokeColor="#EAFBF7"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- A：left leg -->
    <path
        android:pathData="M58,70 L69,36"
        android:strokeColor="#BBDFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- A：right leg -->
    <path
        android:pathData="M69,36 L80,70"
        android:strokeColor="#BBDFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- A：crossbar -->
    <path
        android:pathData="M62.5,59.5 L75.5,59.5"
        android:strokeColor="#BBDFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
