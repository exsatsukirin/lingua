<?xml version="1.0" encoding="utf-8"?><!--
   See backup_rules.xml: the Keystore-encrypted API keys cannot be restored
   on another device, so their DataStore file is excluded from both cloud
   backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
