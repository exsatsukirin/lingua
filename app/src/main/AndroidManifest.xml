<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Screen text recognition captures exactly one frame. Android 14+ only hands out the
      MediaProjection token to an already-running foreground service of type mediaProjection.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- The screen-translate shortcut lives in a notification; Android 13+ gates posting it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LinguaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lingua"
        android:windowSoftInputMode="adjustResize">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Screenshots shared from the system share sheet open screen text recognition. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Grabs one frame for on-device OCR and stops immediately afterwards. -->
        <service
            android:name=".capture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          Started by the resident notification's tap. The window is transparent and draws nothing
          until the frame is captured, so what gets captured is the app underneath.

          An empty taskAffinity keeps it out of the app's own task: launching the main task would
          bring Lingua's UI back to the front, and that is what would end up in the capture.
        -->
        <activity
            android:name=".ui.screentranslate.ScreenTranslateActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Lingua.ScreenTranslate" />

        <!-- The notification's "turn off" action. -->
        <receiver
            android:name=".ui.screentranslate.ScreenTranslateDismissReceiver"
            android:exported="false" />

        <!--
          "Translate this" entry in any app's text-selection toolbar.
          The label below is what the system shows in that menu; the activity itself
          renders a dialog-style popup so the user never leaves the source app.
        -->
        <activity
            android:name=".ui.processtext.ProcessTextActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:noHistory="true"
            android:theme="@style/Theme.Lingua.ProcessText">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
